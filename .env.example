# ===================================================================
# Gilda del Grifone - Telegram Help & FAQ Bot Configuration
# ===================================================================

# 1. Telegram Bot Token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Telegram Bot Username (with @ symbol, used in greetings and links)
BOT_USERNAME=@GdG_Help_Bot

# 3. Ticket Admin Chat ID
# The Telegram Chat ID of the group/channel where tickets will be forwarded.
# Tip: Supergroups usually start with -100 (e.g., -1001234567890)
TICKET_CHAT_ID=-1001234567890

# 4. GitHub Repository Configuration
# The repo where FAQ markdown files, images, and index are stored.
GITHUB_REPO=Destard20/GdG-Help-Bot
GITHUB_BRANCH=main

# (Optional) Direct Raw Content URL override. If omitted, constructed automatically as:
# https://raw.githubusercontent.com/${GITHUB_REPO}/${GITHUB_BRANCH}
# GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com/Destard20/GdG-Help-Bot/main


# 5. Database Configuration
DATABASE_PATH=tickets.db

# 6. Fallback & Cache Settings
# If true, the bot will use local FAQ files/templates when developing locally or if GitHub is unreachable
USE_LOCAL_FALLBACK=true

# Index cache time in seconds (e.g. 300 = 5 minutes)
FAQ_CACHE_TTL=300
